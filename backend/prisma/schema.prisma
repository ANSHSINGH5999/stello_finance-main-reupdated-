generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Validator {
  id               Int       @id @default(autoincrement())
  pubkey           String    @unique
  uptime           Float
  commission       Float
  votingPower      Float?
  performanceScore Float
  allocatedStake   BigInt
  lastChecked      DateTime

  history ValidatorHistory[]

  @@map("validators")
}

model ValidatorHistory {
  id               Int      @id @default(autoincrement())
  validatorId      Int
  uptime           Float
  commission       Float
  performanceScore Float
  allocatedStake   BigInt
  timestamp        DateTime @default(now())

  validator Validator @relation(fields: [validatorId], references: [id])

  @@index([validatorId, timestamp])
  @@map("validator_history")
}

model RewardSnapshot {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime @default(now())
  totalStaked  BigInt
  totalSupply  BigInt
  exchangeRate Float
  apy          Float

  @@map("reward_snapshots")
}

model Withdrawal {
  id         Int      @id @default(autoincrement())
  wallet     String
  amount     BigInt
  status     String   @default("pending")
  unlockTime DateTime
  createdAt  DateTime @default(now())

  @@index([wallet])
  @@index([status])
  @@map("withdrawals")
}

model ProtocolMetrics {
  id                Int      @id @default(autoincrement())
  totalStaked       BigInt
  totalSupply       BigInt
  tvlUsd            Float
  avgValidatorScore Float
  protocolFees      BigInt   @default(0)
  updatedAt         DateTime @default(now())

  @@map("protocol_metrics")
}

model CollateralPosition {
  id            Int      @id @default(autoincrement())
  wallet        String
  sxlmDeposited BigInt
  xlmBorrowed   BigInt
  healthFactor  Float
  updatedAt     DateTime @default(now())

  @@index([wallet])
  @@map("collateral_positions")
}

model LPPosition {
  id            Int      @id @default(autoincrement())
  wallet        String
  lpTokens      BigInt
  xlmDeposited  BigInt
  sxlmDeposited BigInt
  updatedAt     DateTime @default(now())

  @@index([wallet])
  @@map("lp_positions")
}

// status values: active | passed | queued | executed | rejected | cancelled
model GovernanceProposal {
  id           Int      @id @default(autoincrement())
  proposer     String
  paramKey     String
  newValue     String
  votesFor     BigInt   @default(0)
  votesAgainst BigInt   @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  // Timelock fields (populated after execute_proposal on-chain)
  timelockOpId String?  // hex-encoded BytesN<32> operation ID
  queuedAt     DateTime?
  etaLedger    Int?     // earliest ledger for finalization
  finalizedAt  DateTime?

  timelockOperation TimelockOperation?

  @@map("governance_proposals")
}

// Tracks each operation in the on-chain Timelock contract.
// status values: queued | executed | cancelled | expired
model TimelockOperation {
  id           Int      @id @default(autoincrement())
  opId         String   @unique // hex-encoded BytesN<32>
  proposalId   Int      @unique
  paramKey     String
  newValue     String
  status       String   @default("queued")
  etaLedger    Int
  expiryLedger Int
  queuedAt     DateTime @default(now())
  executedAt   DateTime?
  cancelledAt  DateTime?

  proposal GovernanceProposal @relation(fields: [proposalId], references: [id])

  @@index([status])
  @@index([etaLedger])
  @@map("timelock_operations")
}

model LiquidationEvent {
  id               Int      @id @default(autoincrement())
  txHash           String?
  eventIndex       Int?
  contractId       String?
  liquidator       String
  borrower         String
  debtRepaid       BigInt
  collateralSeized BigInt
  ledger           Int
  ledgerClosedAt   DateTime?
  createdAt        DateTime @default(now())

  @@unique([txHash, eventIndex])
  @@index([borrower])
  @@index([liquidator])
  @@index([contractId, ledger])
  @@map("liquidation_events")
}

// ─── Event-level tables ────────────────────────────────────────────────────

enum StakeEventType {
  STAKE
  UNSTAKE
}

model StakeEvent {
  id             Int            @id @default(autoincrement())
  txHash         String
  eventIndex     Int
  contractId     String
  ledger         Int
  ledgerClosedAt DateTime
  wallet         String
  amount         BigInt
  type           StakeEventType
  createdAt      DateTime       @default(now())

  @@unique([txHash, eventIndex])
  @@index([wallet])
  @@index([ledger])
  @@index([contractId, ledger])
  @@index([type, ledger])
  @@map("stake_events")
}

model BorrowEvent {
  id             Int      @id @default(autoincrement())
  txHash         String
  eventIndex     Int
  contractId     String
  ledger         Int
  ledgerClosedAt DateTime
  wallet         String
  amount         BigInt
  asset          String
  createdAt      DateTime @default(now())

  @@unique([txHash, eventIndex])
  @@index([wallet])
  @@index([ledger])
  @@index([contractId, ledger])
  @@map("borrow_events")
}

model RepayEvent {
  id             Int      @id @default(autoincrement())
  txHash         String
  eventIndex     Int
  contractId     String
  ledger         Int
  ledgerClosedAt DateTime
  wallet         String
  amount         BigInt
  asset          String
  createdAt      DateTime @default(now())

  @@unique([txHash, eventIndex])
  @@index([wallet])
  @@index([ledger])
  @@index([contractId, ledger])
  @@map("repay_events")
}

model FlashLoanEvent {
  id             Int      @id @default(autoincrement())
  txHash         String
  eventIndex     Int
  contractId     String
  ledger         Int
  ledgerClosedAt DateTime
  wallet         String
  amount         BigInt
  asset          String
  fee            BigInt
  createdAt      DateTime @default(now())

  @@unique([txHash, eventIndex])
  @@index([wallet])
  @@index([ledger])
  @@index([contractId, ledger])
  @@map("flash_loan_events")
}

// ─── Indexer cursor ────────────────────────────────────────────────────────

model IndexerCursor {
  id            Int      @id @default(autoincrement())
  contractId    String   @unique
  lastLedger    Int      @default(0)
  lastTxHash    String?
  lastEventIndex Int?
  updatedAt     DateTime @updatedAt

  @@map("indexer_cursors")
}

// ─── Time-series aggregation tables ───────────────────────────────────────

enum RevenueSource {
  LENDING
  LP
  TREASURY
}

model LendingUtilizationSnapshot {
  id               Int      @id @default(autoincrement())
  contractId       String
  windowStart      DateTime
  windowEnd        DateTime
  totalDeposited   BigInt
  totalBorrowed    BigInt
  utilizationRate  Float
  createdAt        DateTime @default(now())

  @@unique([contractId, windowStart])
  @@index([contractId, windowStart])
  @@map("lending_utilization_snapshots")
}

model RevenueSnapshot {
  id          Int           @id @default(autoincrement())
  source      RevenueSource
  windowStart DateTime
  windowEnd   DateTime
  amount      BigInt
  createdAt   DateTime      @default(now())

  @@unique([source, windowStart])
  @@index([source, windowStart])
  @@map("revenue_snapshots")
}

// ─── Cohort / retention tables ─────────────────────────────────────────────

model WalletFirstActivity {
  id               Int      @id @default(autoincrement())
  wallet           String   @unique
  firstStakeLedger Int?
  firstStakeAt     DateTime?
  firstBorrowLedger Int?
  firstBorrowAt    DateTime?
  updatedAt        DateTime @updatedAt

  @@index([firstStakeAt])
  @@index([firstBorrowAt])
  @@map("wallet_first_activity")
}

model WalletDailyActivity {
  id             Int      @id @default(autoincrement())
  wallet         String
  date           DateTime @db.Date
  isStakeActive  Boolean  @default(false)
  isBorrowActive Boolean  @default(false)
  stakedAmount   BigInt   @default(0)
  borrowedAmount BigInt   @default(0)
  createdAt      DateTime @default(now())

  @@unique([wallet, date])
  @@index([date])
  @@index([wallet])
  @@map("wallet_daily_activity")
}

model CohortRetention {
  id             Int      @id @default(autoincrement())
  cohortDate     DateTime @db.Date
  dayOffset      Int
  totalWallets   Int
  retainedWallets Int
  retentionRate  Float
  computedAt     DateTime @default(now())

  @@unique([cohortDate, dayOffset])
  @@index([cohortDate])
  @@map("cohort_retention")
}

model CohortAvgPositionSize {
  id               Int      @id @default(autoincrement())
  cohortDate       DateTime @db.Date
  dayOffset        Int
  avgCollateralSize Float
  avgBorrowSize    Float
  computedAt       DateTime @default(now())

  @@unique([cohortDate, dayOffset])
  @@index([cohortDate])
  @@map("cohort_avg_position_size")
}
