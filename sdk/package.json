{
  "name": "@stello/dex-sdk",
  "version": "0.1.0",
  "description": "Public SDK for integrating sXLM/XLM trading pairs into DEXes (StellarX, Lumenswap, etc.)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
