    "dev": "tsc --watch"
  },
  "keywords": ["stellar", "sxlm", "xlm", "dex", "liquidity", "twap", "oracle", "defi"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
